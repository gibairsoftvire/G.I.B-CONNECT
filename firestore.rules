rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function access(){return get(/databases/$(database)/documents/access/$(request.auth.uid)).data;}
  function slotBound(d,uid){return d.role in ['moderator','admin'] && d.slot in ['1','2','3','4','5','6'] && get(/databases/$(database)/documents/moderators/$(d.slot)).data.uid==uid;}
  function slotBoundAfter(d,uid){return d.slot in ['1','2','3','4','5','6'] && getAfter(/databases/$(database)/documents/moderators/$(d.slot)).data.uid==uid;}
  function enabled(){return signed() && access().enabled == true && (access().role in ['owner','member'] || slotBound(access(),request.auth.uid));}
  function admin(){return enabled() && access().role in ['owner','moderator','admin'];}
  function owner(){return enabled() && access().role == 'owner';}
   function participantMember(){return enabled() && access().role != 'owner';}
  function validated(uid){return exists(/databases/$(database)/documents/memberships/$(uid)) && get(/databases/$(database)/documents/memberships/$(uid)).data.validated==true;}
  function featureAccess(){return enabled() && (admin() || !exists(/databases/$(database)/documents/restrictions/$(request.auth.uid)) || get(/databases/$(database)/documents/restrictions/$(request.auth.uid)).data.suspended!=true || validated(request.auth.uid));}
  function text(v,n){return v is string && v.size() <= n;}
  function validPhoto(){return !('image' in request.resource.data) || (admin() && request.resource.data.image is string && request.resource.data.image.size()<=200000 && request.resource.data.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));}
  function invited(){return signed() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.enabled == true;}
  function invitedRole(){return get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role;}
  match /access/{uid} {
   function valid(){return request.resource.data.enabled is bool && ((request.resource.data.role=='member' && request.resource.data.keys().hasOnly(['role','enabled'])) || (request.resource.data.role=='moderator' && request.resource.data.keys().hasOnly(['role','enabled','slot']) && slotBoundAfter(request.resource.data,uid)));}
   function ownInvite(){let invitation=get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data;return signed() && uid==request.auth.uid && invited() && request.resource.data.enabled==true && request.resource.data.role==invitation.role && (invitation.role=='member' || (invitation.role=='moderator' && request.resource.data.slot==invitation.slot && getAfter(/databases/$(database)/documents/moderators/$(invitation.slot)).data.email==request.auth.token.email.lower()));}
   allow get: if signed() && (request.auth.uid == uid || owner());
   allow list: if owner();
   allow create: if valid() && (owner() || ownInvite());
   allow update: if valid() && ((owner() && uid!=request.auth.uid && resource.data.role!='owner') || (resource.data.role=='member' && resource.data.enabled==true && request.resource.data.role=='moderator' && ownInvite()));
   allow delete: if owner() && uid!=request.auth.uid && resource.data.role!='owner';
  }
  match /moderators/{slot} {
   function valid(){return slot in ['1','2','3','4','5','6'] && request.resource.data.keys().hasOnly(['email','uid']) && text(request.resource.data.email,254) && text(request.resource.data.uid,128);}
   allow get: if owner() || (signed() && (resource.data.uid==request.auth.uid || (request.auth.token.email_verified==true && resource.data.email==request.auth.token.email.lower())));
   allow list: if owner();
   allow create: if owner() && valid();
   allow update: if valid() && (owner() || (signed() && request.auth.token.email_verified==true && resource.data.email==request.auth.token.email.lower() && request.resource.data.email==resource.data.email && (resource.data.uid=='' || resource.data.uid==request.auth.uid) && request.resource.data.uid==request.auth.uid && invited() && invitedRole()=='moderator' && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.slot==slot));
   allow delete: if owner();
  }
  match /invitations/{email} {
   function valid(){return request.resource.data.enabled is bool && ((request.resource.data.role=='member' && request.resource.data.keys().hasOnly(['role','enabled','createdAt'])) || (request.resource.data.role=='moderator' && request.resource.data.keys().hasOnly(['role','enabled','createdAt','slot']) && request.resource.data.slot in ['1','2','3','4','5','6'] && getAfter(/databases/$(database)/documents/moderators/$(request.resource.data.slot)).data.email==email));}
   allow get: if admin() || (signed() && request.auth.token.email_verified == true && email == request.auth.token.email.lower());
   allow list: if admin();
   allow create, update: if valid() && admin() && (request.resource.data.role=='member' || owner()) && (request.method=='create' || resource.data.role=='member' || owner());
   allow delete: if admin() && (resource.data.role=='member' || owner());
  }
  match /profiles/{uid} {
   function valid(){return request.resource.data.keys().hasOnly(['nickname','grade','speciality']) && text(request.resource.data.nickname,40) && request.resource.data.nickname.size()>0 && text(request.resource.data.grade,70) && request.resource.data.speciality is list && request.resource.data.speciality.size()<=20;}
   allow read: if enabled();
   allow create: if enabled() && valid() && (admin() || (uid==request.auth.uid && request.resource.data.grade=='' && request.resource.data.speciality.size()==0));
   allow update: if enabled() && valid() && (admin() || (uid==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])));
  }
  match /settings/{id} {
   allow read: if enabled();
   allow create, update: if admin() && id=='catalog' && request.resource.data.keys().hasOnly(['grades','specialities']) && request.resource.data.grades is list && request.resource.data.specialities is list && request.resource.data.grades.size()<=50 && request.resource.data.specialities.size()<=50;
   allow create, update: if owner() && id=='push' && request.resource.data.keys().hasOnly(['enabled','relayUrl']) && request.resource.data.enabled is bool && request.resource.data.relayUrl is string && request.resource.data.relayUrl.matches('https://script[.]google[.]com/macros/s/[A-Za-z0-9_-]+/exec');
  }
  match /terrains/{id} {
   allow read: if enabled();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','lat','lon','address','access']) && text(request.resource.data.name,80) && text(request.resource.data.address,200) && text(request.resource.data.access,600) && ((request.resource.data.lat=='' && request.resource.data.lon=='') || (request.resource.data.lat is number && request.resource.data.lon is number && request.resource.data.lat>=-90 && request.resource.data.lat<=90 && request.resource.data.lon>=-180 && request.resource.data.lon<=180));
   allow delete: if admin();
  }
  match /memberships/{uid} {
   allow get: if enabled() && (admin() || uid==request.auth.uid);
   allow list: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['period','amount','method','start','end','validated']) && request.resource.data.period in ['mensuelle','annuelle'] && request.resource.data.amount==(request.resource.data.period=='mensuelle'?15:150) && request.resource.data.method in ['especes','cheque','virement','helloasso'] && request.resource.data.start is string && request.resource.data.end is string && request.resource.data.end>=request.resource.data.start && request.resource.data.validated is bool;
  }
  match /restrictions/{uid} {
   allow get: if enabled() && (admin() || uid==request.auth.uid);
   allow list: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['suspended']) && request.resource.data.suspended is bool && (!request.resource.data.suspended || (!validated(uid) && get(/databases/$(database)/documents/access/$(uid)).data.role=='member'));
   allow delete: if admin();
  }
  match /events/{id} {
   function validEvent(){return request.resource.data.keys().hasOnly(['name','type','date','time','place','terrainId','capacity','deadline','startsAt','closesAt','yesUids','endTime','security','equipment','instructionsVersion','instructionsUpdatedAt','instructionsEditor','endDate','endsAt','types','createdAt']) && text(request.resource.data.name,120) && request.resource.data.type in ['Partie','Réunion','Aménagement','Autre'] && (!('types' in request.resource.data) || (request.resource.data.types is list && request.resource.data.types.size()>=1 && request.resource.data.types.size()<=4 && request.resource.data.types.toSet().size()==request.resource.data.types.size() && request.resource.data.types.hasOnly(['Partie','Réunion','Aménagement','Autre']) && request.resource.data.types[0]==request.resource.data.type)) && text(request.resource.data.date,10) && text(request.resource.data.time,5) && text(request.resource.data.place,200) && text(request.resource.data.terrainId,100) && (!('endDate' in request.resource.data) || (text(request.resource.data.endDate,10) && request.resource.data.endDate>=request.resource.data.date)) && (!('endsAt' in request.resource.data) || (request.resource.data.endsAt is timestamp && request.resource.data.endsAt>=request.resource.data.startsAt)) && (!('security' in request.resource.data) || text(request.resource.data.security,3000)) && (!('equipment' in request.resource.data) || text(request.resource.data.equipment,3000)) && (!('endTime' in request.resource.data) || text(request.resource.data.endTime,5)) && (!('instructionsVersion' in request.resource.data) || request.resource.data.instructionsVersion is int) && (!('instructionsUpdatedAt' in request.resource.data) || request.resource.data.instructionsUpdatedAt is timestamp) && (!('instructionsEditor' in request.resource.data) || request.resource.data.instructionsEditor is string) && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) && request.resource.data.capacity is int && request.resource.data.capacity>0 && request.resource.data.capacity<=500 && request.resource.data.yesUids is list && request.resource.data.yesUids.size()<=request.resource.data.capacity && request.resource.data.startsAt is timestamp && request.resource.data.closesAt is timestamp && request.resource.data.closesAt<request.resource.data.startsAt && text(request.resource.data.deadline,16);}
   function ownAttendance(){let before=resource.data.yesUids.toSet();let after=request.resource.data.yesUids.toSet();let r=getAfter(/databases/$(database)/documents/events/$(id)/rsvps/$(request.auth.uid)).data;return participantMember() && featureAccess() && request.time<resource.data.closesAt && request.time<resource.data.startsAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yesUids']) && request.resource.data.yesUids is list && request.resource.data.yesUids.size()==after.size() && after.size()<=resource.data.capacity && after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).hasOnly([request.auth.uid]) && r.at==request.time && ((r.response=='yes' && request.auth.uid in after) || (r.response=='no' && !(request.auth.uid in after)));}
   allow read: if featureAccess();
   allow create: if admin() && validEvent() && request.resource.data.yesUids.size()==0 && (request.resource.data.terrainId=='other' || exists(/databases/$(database)/documents/terrains/$(request.resource.data.terrainId)));
   allow update: if (admin() && validEvent() && request.resource.data.yesUids==resource.data.yesUids) || ownAttendance();
   allow delete: if admin();
   match /instructionReads/{readerId} {
    allow get: if featureAccess() && (request.auth.uid==readerId || admin());
    allow list: if admin();
    allow create, update: if featureAccess() && request.auth.uid==readerId && request.resource.data.keys().hasOnly(['version','at']) && request.resource.data.version is int && request.resource.data.version>=1 && request.resource.data.version<=get(/databases/$(database)/documents/events/$(id)).data.instructionsVersion && request.resource.data.at==request.time;
    allow delete: if admin();
   }
   match /instructionHistory/{versionId} {
    allow read: if admin();
    allow create: if admin() && request.resource.data.keys().hasOnly(['security','equipment','version','editedAt','editorId']) && text(request.resource.data.security,3000) && text(request.resource.data.equipment,3000) && request.resource.data.version is int && request.resource.data.editorId==request.auth.uid && request.resource.data.editedAt is timestamp;
    allow delete: if admin();
   }
   match /rsvps/{uid} {
    allow read: if featureAccess();
    allow create, update: if participantMember() && featureAccess() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['response','at','days']) && request.resource.data.response in ['yes','no'] && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size()<=31 && request.resource.data.days.toSet().size()==request.resource.data.days.size() && ((request.resource.data.response=='no' && request.resource.data.days.size()==0) || (request.resource.data.response=='yes' && request.resource.data.days.size()>=1)))) && request.resource.data.at==request.time && request.time<get(/databases/$(database)/documents/events/$(id)).data.closesAt && ((request.resource.data.response=='yes' && uid in getAfter(/databases/$(database)/documents/events/$(id)).data.yesUids) || (request.resource.data.response=='no' && !(uid in getAfter(/databases/$(database)/documents/events/$(id)).data.yesUids)));
    allow delete: if admin();
   }
  }
  match /conversations/{id} {
   function participant(){return enabled() && !('deleting' in resource.data && resource.data.deleting==true) && ((id=='general' && resource.data.type=='general') || (featureAccess() && request.auth.uid in resource.data.participants));}
   allow get: if participant() || admin() || (featureAccess() && !exists(/databases/$(database)/documents/conversations/$(id)));
   allow list: if participant();
   allow create: if enabled() && request.resource.data.keys().hasOnly(['name','type','participants','createdAt']) && text(request.resource.data.name,60) && request.resource.data.createdAt==request.time && request.resource.data.participants is list && request.resource.data.participants.size()<=100 && ((id=='general' && admin() && request.resource.data.type=='general') || (request.resource.data.type=='group' && admin() && request.auth.uid in request.resource.data.participants) || (featureAccess() && request.resource.data.type=='private' && request.resource.data.participants.size()==2 && request.resource.data.participants.toSet().size()==2 && request.auth.uid in request.resource.data.participants));
   allow update: if (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessageId']) && request.resource.data.pinnedMessageId is string && request.resource.data.pinnedMessageId.size()<=128 && (request.resource.data.pinnedMessageId=='' || exists(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.pinnedMessageId))) && !('deleting' in resource.data && resource.data.deleting==true)) || (admin() && id!='general' && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting']) && request.resource.data.deleting==true) || (resource.data.type in ['group','private'] && !('deleting' in resource.data && resource.data.deleting==true) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) && request.resource.data.participants is list && request.resource.data.participants.size()>0 && request.resource.data.participants.size()<=100 && request.resource.data.participants.toSet().size()==request.resource.data.participants.size())));
   allow delete: if admin() && id!='general' && resource.data.deleting==true;
   match /reads/{readerId} {
    allow get: if enabled() && (request.auth.uid==readerId || admin());
    allow list: if admin();
    allow create, update: if enabled() && request.auth.uid==readerId && exists(/databases/$(database)/documents/conversations/$(id)) && ((id=='general') || (featureAccess() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants)) && request.resource.data.keys().hasOnly(['lastSeenAt','at']) && request.resource.data.lastSeenAt is timestamp && request.resource.data.at==request.time;
    allow delete: if admin() && id!='general' && get(/databases/$(database)/documents/conversations/$(id)).data.deleting==true;
   }
   match /messages/{mid} {
    function canRead(){let c=get(/databases/$(database)/documents/conversations/$(id)).data;return enabled() && ((id=='general' && c.type=='general') || (featureAccess() && request.auth.uid in c.participants));}
    allow read: if (canRead() && !('deleting' in get(/databases/$(database)/documents/conversations/$(id)).data && get(/databases/$(database)/documents/conversations/$(id)).data.deleting==true)) || (admin() && id!='general' && get(/databases/$(database)/documents/conversations/$(id)).data.deleting==true);
    allow create: if canRead() && request.resource.data.keys().hasOnly(['authorId','text','createdAt','image','replyTo']) && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.keys().hasOnly(['id','authorId','authorName','text']) && request.resource.data.replyTo.keys().hasAll(['id','authorId','authorName','text']) && text(request.resource.data.replyTo.id,128) && request.resource.data.replyTo.id.size()>0 && text(request.resource.data.replyTo.authorId,128) && text(request.resource.data.replyTo.authorName,40) && text(request.resource.data.replyTo.text,200))) && request.resource.data.authorId==request.auth.uid && text(request.resource.data.text,2000) && (request.resource.data.text.size()>0 || 'image' in request.resource.data) && validPhoto() && request.resource.data.createdAt==request.time;
    allow delete: if (canRead() && resource.data.authorId==request.auth.uid) || (admin() && id!='general' && get(/databases/$(database)/documents/conversations/$(id)).data.deleting==true);
   }
  }
  match /announcements/{id} {
   allow read: if enabled();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['title','body','createdAt']) && text(request.resource.data.title,120) && text(request.resource.data.body,2000);
   allow delete: if admin();
   match /acks/{uid} {
    allow read: if enabled();
    allow create, update: if enabled() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at==request.time;
   }
  }
  match /polls/{id} {
   allow read: if featureAccess();
   allow create: if featureAccess() && request.resource.data.keys().hasOnly(['question','options','createdBy','createdAt','image']) && request.resource.data.createdBy==request.auth.uid && text(request.resource.data.question,200) && validPhoto() && request.resource.data.options is list && request.resource.data.options.size()>=2 && request.resource.data.options.size()<=10 && request.resource.data.createdAt==request.time;
   allow delete: if admin() || (featureAccess() && resource.data.createdBy==request.auth.uid);
   match /votes/{uid} {
    allow read: if featureAccess();
    allow create, update: if participantMember() && featureAccess() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['choices']) && request.resource.data.choices is list && request.resource.data.choices.size()<=10 && request.resource.data.choices.hasOnly(get(/databases/$(database)/documents/polls/$(id)).data.options);
   }
  }
  match /pushDevices/{id} {
   function valid(){return id.matches('[a-f0-9]{64}') && request.resource.data.keys().hasOnly(['uid','token','updatedAt']) && request.resource.data.uid==request.auth.uid && text(request.resource.data.token,4096) && request.resource.data.token.size()>20 && request.resource.data.updatedAt==request.time;}
   allow get, list: if enabled() && resource.data.uid==request.auth.uid;
   allow create, update: if enabled() && valid();
   allow delete: if signed() && resource.data.uid==request.auth.uid;
  }
  match /pushDeliveries/{id} {allow read, write: if false;}
  match /preferences/{uid} {
   allow get: if enabled() && uid==request.auth.uid;
   allow create, update: if enabled() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['messages','groups','events']) && request.resource.data.messages is bool && request.resource.data.groups is bool && request.resource.data.events is bool;
  }
  match /boutiques/{id} {
   function validBoutique(){return request.resource.data.keys().hasOnly(['name','url','logo','deleted']) && text(request.resource.data.name,80) && request.resource.data.name.size()>0 && request.resource.data.url is string && request.resource.data.url.size()<=500 && request.resource.data.url.matches('https://[^ ]+') && request.resource.data.logo is string && request.resource.data.logo.size()<=270000 && (request.resource.data.logo=='' || request.resource.data.logo.matches('assets/boutiques/[a-z0-9-]+[.]webp') || request.resource.data.logo.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')) && request.resource.data.deleted is bool;}
   allow read: if signed();
   allow create, update: if admin() && validBoutique();
   allow delete: if admin();
  }
  match /{document=**} {allow read, write: if false;}
 }
}
